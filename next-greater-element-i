from typing import List
class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        stack = []
        greater = {}
        for num in nums2:
            while stack and stack[-1] < num:
                temp = stack.pop()
                greater[temp] = num
            stack.append(num)
        result = []
        for num in nums1:
            result.append(greater.get(num, -1))
        return result
        
