class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        n=len(heights)
        PSE=[-1]*n
        NSE=[n]*n
        stack=[]
    # calculate PSE
        for i in range(n):
            while stack and heights[stack[-1]] >= heights[i]:
                stack.pop()
            PSE[i]= stack[-1] if stack else -1
            stack.append(i)
        stack.clear()
    #calculate NSE
        for i in range(n-1,-1,-1):
            while stack and heights[stack[-1]]>=heights[i]:
                stack.pop()
            NSE[i]=stack[-1] if stack else n
            stack.append(i)
    #Find maximum area
        max_area=0
        for i in range(n):
            width=NSE[i]-PSE[i]-1
            max_area=max(max_area,heights[i]*width)
        return max_area 
