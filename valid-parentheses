class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        for i in s:
            if i == '(' or i == '[' or i == '{':
                stack.append(i)
            else:
                if not stack:
                    return False
                top = stack[-1]
                if i == ')' and top == '(':
                    stack.pop()
                elif i == ']' and top == '[':
                    stack.pop()
                elif i == '}' and top == '{':
                    stack.pop()
                else:
                    return False

        return len(stack) == 0
