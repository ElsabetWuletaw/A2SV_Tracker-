class Solution:
    def timeRequiredToBuy(self, tickets: List[int], k: int) -> int:
        queue = deque()
        for i in range(len(tickets)):
            queue.append(i)
        time = 0
        while queue:
            person = queue.popleft()
            tickets[person] -= 1
            time += 1
            if tickets[person] == 0:
                if person == k:
                    return time
            else:
                queue.append(person)
